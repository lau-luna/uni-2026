@startuml
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 70

abstract class AbstractFactory {
  + createProductA()
  + createProductB()
}

class ConcreteFactory1 {
  + createProductA()
  + createProductB()
}

class ConcreteFactory2 {
  + createProductA()
  + createProductB()
}

abstract class ProductA {
  + operation()
}

class ProductA1 {
  + operation()
}

class ProductA2 {
  + operation()
}

abstract class ProductB {
  + operation()
}

class ProductB1 {
  + operation()
}

class ProductB2 {
  + operation()
}

class Client

AbstractFactory <|-down- ConcreteFactory1
AbstractFactory <|-down- ConcreteFactory2

ProductA <|-down- ProductA1
ProductA <|-down- ProductA2

ProductB <|-down- ProductB1
ProductB <|-down- ProductB2

ConcreteFactory1 .down.> ProductA1 : create
ConcreteFactory1 .down.> ProductB1 : create

ConcreteFactory2 .down.> ProductA2 : create
ConcreteFactory2 .down.> ProductB2 : create

Client .right.> AbstractFactory : use
Client .right.> ProductA : use
Client .right.> ProductB : use
@enduml
