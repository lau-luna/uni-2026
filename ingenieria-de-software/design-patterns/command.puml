@startuml
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 70

class Client

class Invoker {
  + storeCommand()
}

class Receiver {
  + action()
}

abstract class Command {
  + execute()
}

class ConcreteCommand {
  - state
  + execute()
}

Command <|-down- ConcreteCommand

Invoker "1" o-right- "0..*" Command : + history

Receiver "1" <-right- "*" ConcreteCommand : - receiver

Client "1" .right.> "*" Invoker : create
Client "1" -right-> "*" Receiver
Client "1" .right.> "*" ConcreteCommand : create
@enduml
