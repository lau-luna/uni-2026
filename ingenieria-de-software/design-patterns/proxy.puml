@startuml
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 70

interface Subject {
  + request()
}

class RealSubject {
  + request()
}

class Proxy {
  + request()
}

class Client

Subject <|.down. RealSubject
Subject <|.down. Proxy

Proxy "*" -right-> "0..1" RealSubject : + realSubject

Client .right.> Subject : use

@enduml
