@startuml


class Localidad {
  nombre
  codigo postal
}

abstract class Persona {
  dni
  nombre
  apellido
  celular
}

Localidad "1" -- "*" Persona

class Bioquimico {
  nroMatricula
}

class Paciente {
  numeroAfiliado
  email
}

class Pedido {

}

note top of Paciente
  El enunciado da a entender que el numero de afiliado 
  es un atributo del comprobante, pero es en realidad un 
  atributo de paciente. Como es un valor unico por cada 
  paciente, se repetiría en los comprobantes de un 
  mismo paciente.
  Además, en el escenario se registra el numero de 
  afiliado junto con los datos del paciente.
endnote

Persona <|-- Bioquimico
Persona <|-- Paciente

class Estudio {
  nombre
  codigo
  descripcion
 costo
}

Bioquimico "1..*" -- "1..*" Estudio : realiza >

abstract class Reactivo {
  nombre
  codigo
}

Estudio "*" -- "1..3" Reactivo

class EstadoReactivo {
  estado:TEstado
}

(Reactivo, Estudio) .. EstadoReactivo


class ReactivoNacional {
}

class Marca {
  nombre
}

ReactivoNacional "*" -- "1" Marca

class ReactivoInternacional {
}

class Importador {
  nombre
}

Reactivo <|-- ReactivoNacional
Reactivo <|-- ReactivoInternacional
ReactivoInternacional "*" --  "*" Importador : < provee
ReactivoInternacional "*" -- "1" Bioquimico : < responsable

class MonedaReactivo {
  moneda:TMoneda
}

(ReactivoInternacional, Importador) .. MonedaReactivo


class Comprobante {
  identificador
  fecha
  montoMutual
  montoPaciente
}

Pedido "1" *-- "1" Comprobante : tiene >

Pedido "*" -- "1..*" Estudio : tiene >
Paciente "1" -- "*" Pedido : recibe >

class Resultado {
  descripcion
  valoracion
}

(Estudio, Pedido) .. Resultado

class Usuario {
  nombreUsuario
  contraseña
}

Usuario "*" -- "*" Paciente : accede a los datos >

enum TMoneda {
  Peso
  Dolar
  Euro
}

enum TEstado {
 TemperaturaFrio
 TemperaturaAmbiente
}
@enduml
